{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/doctor.sh", "timeout": 60 }]
      },
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/doctor.sh --quick --keep", "timeout": 30 }]
      }
    ]
  }
}
